PORT=3000
PHONOFETCH_IMAGE=phonofetch:local
TZ=Europe/Lisbon
DATABASE_PATH=/data/phonofetch.sqlite
SLSKD_BASE_URL=http://slskd:5030
SLSKD_API_KEY=replace-with-raw-readwrite-api-secret
PHONOFETCH_AUTH_USERNAME=admin
PHONOFETCH_AUTH_PASSWORD=replace-with-a-long-unique-password
PHONOFETCH_SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
SEARCH_CONCURRENCY=2
SEARCH_TIMEOUT_MS=45000
SEARCH_FAST_WINDOW_MS=5000
SEARCH_RESULT_LIMIT=120
MAX_RETRIES=3
AUTO_TRACK_SCORE=0.93
AUTO_ALBUM_SCORE=0.98
MAX_FOLDER_FILES=250
MAX_FOLDER_BYTES=10737418240
